# Get a key at https://openrouter.ai/keys . Never commit the real .env file.
OPENROUTER_API_KEY=

# Models are tried in order; change this line to switch models, including paid ones.
LLM_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free

# "openrouter" uses the real model. "stub" gives placeholder replies with no network or key.
LLM_PROVIDER=openrouter
